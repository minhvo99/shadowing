# Copy to .env.local (git-ignored) for server-only secrets.
# Server-side only (api/video.ts). NO VITE_ prefix: that would ship the proxy password to every browser.
# On Vercel set it in Project → Settings → Environment Variables.
YT_PROXY_URL=

# Telegram agent (pnpm agent): token from @BotFather; chat id is what the bot replies on your first message.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# MAX_BUDGET_USD=5
# MAX_TURNS=80
