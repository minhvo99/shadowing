# Public config, bundled into the browser code (Vite only exposes VITE_* to the client).
# Never put secrets here or behind a VITE_ prefix.

# Our API (api/video.ts). Empty = same origin (Vercel / vite dev).
VITE_API_BASE_URL=

# Dictionary: English definitions + audio, fallback definitions, Vietnamese machine translation.
VITE_DICTIONARY_API_URL=https://api.dictionaryapi.dev/api/v2/entries/en
VITE_WIKTIONARY_API_URL=https://en.wiktionary.org/api/rest_v1/page/definition
VITE_TRANSLATE_API_URL=https://api.mymemory.translated.net/get

# Video title when our server is blocked by YouTube.
VITE_YOUTUBE_OEMBED_URL=https://www.youtube.com/oembed

# "Get the subtitle file" hand-off; the YouTube URL is appended.
VITE_SUBTITLE_DOWNLOADER_URL=https://subtitle.to/
